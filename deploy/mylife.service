[Unit]
Description=MyLife phase-0 demo backend (chat, memory, TTS/ASR proxy, conversation archive)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mylife
Group=mylife
EnvironmentFile=/etc/mylife/secrets.env
Environment=MYLIFE_PORT=18960
Environment=MYLIFE_CACHE=/var/cache/mylife
Environment=MYLIFE_DATA=/var/lib/mylife
Environment=MYLIFE_TTS_DAILY_CHARS=100000
Environment=PYTHONUNBUFFERED=1
# Users are in China: "today" (the date the selves are told, memory dates, daily caps, archive day files) follows
# Beijing time. Before 2026-11-24 the server ran on UTC, so older archive and memory timestamps are UTC.
Environment=TZ=Asia/Shanghai
ExecStart=/usr/bin/python3 /opt/mylife/app/mylife_server.py
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/cache/mylife
# /var/lib/mylife: long-term memory (users/) and the conversation archive (logs/); never treat it as cache
StateDirectory=mylife
StateDirectoryMode=0750
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
