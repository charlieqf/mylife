[Unit]
Description=MyLife phase-0 demo backend (voice catalog + Tencent TTS proxy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mylife
Group=mylife
EnvironmentFile=/etc/mylife/secrets.env
Environment=MYLIFE_PORT=18960
Environment=MYLIFE_CACHE=/var/cache/mylife
Environment=MYLIFE_TTS_DAILY_CHARS=100000
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/mylife/app/mylife_server.py
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/cache/mylife
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
